# Copy to .env and fill in. NEVER commit .env.
# Delphi Mainnet API key — create at https://api-access.delphi.fyi/ (keep Mainnet selected).
DELPHI_API_ACCESS_KEY=
# Evidence API base URL (Mainnet).
DELPHI_API_URL=https://delphi.fyi/v1
# Competition site (markets list lives at <site>/markets.json).
COMPETITION_SITE_URL=https://competition.delphi.fyi
# Override the markets list URL directly (used by tests to point at a local fixture).
# MARKETS_JSON_URL=

# Agent identity — sent as X-Agent-Id / X-Agent-Harness / X-Agent-Model on every call.
AGENT_ID=florex-evidence
AGENT_HARNESS=muse-agent
AGENT_MODEL=

# Research provider: "gemini" (needs GEMINI_API_KEY) or "file" (FACT_* env vars, operator-driven).
RESEARCH_PROVIDER=file
# Google AI Studio key for Gemini research with Search grounding. Get one at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# File-provider fact (only used when RESEARCH_PROVIDER=file).
# FACT=On 2026-11-25 the statistics office published the October figure: 3.1%.
# FACT_SOURCE=https://example.com/release
# FACT_DATE=2026-11-25
# FACT_PUBLISHER=National Statistics Office
# FACT_WHY=The market resolves Yes if the November print is at or above 3.00%.
# MARKET_ADDRESS=0x...

# Terms acceptance. Set ONLY after the account holder has read the terms at the
# URL the agent prints and approved that exact version. The agent never accepts
# terms on its own.
# ACCEPT_TERMS=

# Run behaviour.
MAX_MARKETS_PER_CYCLE=3
CYCLE_INTERVAL_MINUTES=60
# DRY_RUN=true researches and prints the notes it would submit, but submits nothing.
DRY_RUN=false
STATE_PATH=./state/evidence-state.json
LOG_PATH=./evidence-log.jsonl
